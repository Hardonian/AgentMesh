# AgentMesh Configuration — Example Environment Variables
# For local evaluation, all variables are optional (defaults to in-memory mode).

# -----------------------------------------------------------------------------
# Control Plane & Networking
# -----------------------------------------------------------------------------
AGENTMESH_SERVER_URL=http://127.0.0.1:8080
AGENTMESH_PROXY_PORT=8081
AGENTMESH_API_KEY=mesh_sec_dev_local_admin_key

# -----------------------------------------------------------------------------
# Database & Persistence (Optional for local memory mode)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgres://agentmesh:password@localhost:5432/agentmesh?sslmode=disable
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=10

# -----------------------------------------------------------------------------
# Google Cloud & Model Adapters (Optional for local simulator mode)
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
# GCP_PROJECT_ID=my-gcp-project
# GEMINI_API_KEY=AIzaSy...

# -----------------------------------------------------------------------------
# Telemetry & Observability
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# LOG_LEVEL=info
