# Multi-stage Build for AgentMesh Data Plane Proxy
FROM golang:1.26-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /agentmesh-proxy ./cmd/agentmesh-proxy

# Minimal non-root runtime container
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -S agentmesh && adduser -S agentmesh -G agentmesh

USER agentmesh
WORKDIR /home/agentmesh

COPY --from=builder /agentmesh-proxy /usr/local/bin/agentmesh-proxy

EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/agentmesh-proxy"]
